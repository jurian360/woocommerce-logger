# -----------------------------------------------------------------------------
# Copy this file to `.env.local` for local development, and add the same keys to
# your Vercel project (Settings -> Environment Variables) for production.
# Never commit the real `.env.local`.
# -----------------------------------------------------------------------------

# MongoDB Atlas connection string. Include the database name in the path.
# Atlas -> Cluster -> Connect -> Drivers.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/woocommerce_audit?retryWrites=true&w=majority&appName=Cluster0"

# Optional: override the database name from the connection string.
# MONGODB_DB="woocommerce_audit"

# Shared secret sent by the WordPress plugin in the `X-Api-Secret` header.
# Generate one with: openssl rand -hex 32
API_SECRET="replace-me-with-a-long-random-string"

# --- Dashboard protection (optional but strongly recommended) -----------------
# When BOTH are set, `/` and `/api/logs` are protected with HTTP Basic Auth.
# When either is empty, the dashboard is publicly readable.
DASHBOARD_USER=""
DASHBOARD_PASSWORD=""

# --- Display ------------------------------------------------------------------
# IANA timezone used to render timestamps in the dashboard. Defaults to UTC.
DASHBOARD_TIMEZONE="Europe/Amsterdam"
