# -----------------------------------------------------------------------------
# Copy this file to `.env.local` for local development, and add the same keys to
# your Vercel project (Settings -> Environment Variables) for production.
# Never commit the real `.env.local`.
# -----------------------------------------------------------------------------

# MongoDB Atlas connection string. Include the database name in the path.
# Atlas -> Cluster -> Connect -> Drivers.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/woocommerce_audit?retryWrites=true&w=majority&appName=Cluster0"

# Optional: override the database name from the connection string.
# MONGODB_DB="woocommerce_audit"

# Shared secret sent by the WordPress plugin in the `X-Api-Secret` header.
# Generate one with: openssl rand -hex 32
API_SECRET="replace-me-with-a-long-random-string"

# --- Dashboard protection (optional but strongly recommended) -----------------
# The dashboard password. When set, `/` asks for it on a login screen and stays
# unlocked for 7 days; when empty, the dashboard is publicly readable.
# There is no username — this is the only credential.
# Changing it signs everyone out immediately, because the session cookie is
# signed with it. The API routes are unaffected: they use API_SECRET.
DASHBOARD_PASSWORD=""

# --- Retention ----------------------------------------------------------------
# How long an audit entry is kept, in days. Defaults to 14. The dashboard never
# shows anything older, and the daily cron (see vercel.json) deletes it.
# LOG_RETENTION_DAYS="14"

# Secret for the retention cron. Vercel sends `Authorization: Bearer $CRON_SECRET`
# on scheduled invocations, but only when this is set — without it the daily
# purge is rejected with a 401. Generate one with: openssl rand -hex 32
CRON_SECRET=""

# --- Display ------------------------------------------------------------------
# Timezone the dashboard starts in. Either an IANA name, which follows DST:
#   DASHBOARD_TIMEZONE="Europe/Amsterdam"
# or a fixed whole-hour offset, which does not:
#   DASHBOARD_TIMEZONE="UTC-3"
# Readers can switch zones from the picker above the table (that choice lives in
# the `?tz=` URL parameter, so a link keeps it); this is only the default.
# Defaults to UTC. Anything unrecognised falls back to UTC rather than failing.
DASHBOARD_TIMEZONE="Europe/Amsterdam"
